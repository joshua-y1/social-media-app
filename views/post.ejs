<%- include('partials/header') -%>

<div class="container">
  <div class="row justify-content-center mt-5">
    <div class="col-12 col-md-6">
      <h2><%= post.title %></h2>
      <img class="img-fluid rounded" src="<%= post.image %>" alt="<%= post.title %>" />

      <div class="d-flex align-items-center justify-content-between mt-3">
        <form action="/post/likePost/<%= post.id %>?_method=PUT" method="POST">
          <button class="btn btn-primary" type="submit" aria-label="Like post">
            <i class="fa-solid fa-heart"></i>
          </button>
        </form>

        <h3 class="h5 mb-0">Likes: <%= post.likes %></h3>

        <% if (post.user.equals(user._id)) { %>
          <form
            action="/post/deletePost/<%= post.id %>?_method=DELETE"
            method="POST"
            onsubmit="return confirm('Delete this post?')"
          >
            <button class="btn btn-danger" type="submit" aria-label="Delete post">
              <i class="fa-solid fa-trash"></i>
            </button>
          </form>
        <% } %>
      </div>
    </div>

    <div class="col-12 col-md-3 mt-4 mt-md-5">
      <p><%= post.caption %></p>
    </div>

    <div class="col-12 col-md-9 mt-4">
      <a class="btn btn-outline-primary" href="/profile">Return to Profile</a>
      <a class="btn btn-outline-primary" href="/feed">Return to Feed</a>
    </div>
  </div>
</div>

<%- include('partials/footer') -%>